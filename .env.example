# Database
DATABASE_HOST=droppers-db
DATABASE_PORT=5432
DATABASE_USER=droppers
DATABASE_PASSWORD=change-me-to-a-strong-password
DATABASE_NAME=droppers

# Server
DROPPERS_BIND_ADDRESS=0.0.0.0
DROPPERS_TLS_ENABLED=false
DROPPERS_TLS_KEY_STORE=
DROPPERS_TLS_KEY_STORE_PASSWORD=
DROPPERS_TLS_KEY_ALIAS=

# Uploads and JSON
MULTIPART_MAX_FILE_SIZE=50MB
MULTIPART_MAX_REQUEST_SIZE=50MB
JACKSON_DEFAULT_PROPERTY_INCLUSION=non_null

# Database behavior
JPA_SHOW_SQL=false

# Application security and limits
DROPPERS_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DROPPERS_RATE_LIMIT_PER_MINUTE=120
DROPPERS_REQUIRE_TLS_FOR_LAN=false
DROPPERS_DEVICE_SESSION_TTL_DAYS=30
DROPPERS_DEVICE_PORTAL_URL=

# Compose host port
DROPPERS_PORT=8765
